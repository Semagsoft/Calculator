<Window x:Class="AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About" Icon="about.ico" Height="180" Width="220" Name="AboutDialog" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Background="#7AFFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="99*" />
            <ColumnDefinition Width="99*" />
        </Grid.ColumnDefinitions>
        <Button Height="23" Margin="12,0,12,1" Name="OKButton" VerticalAlignment="Bottom" Grid.Column="1" IsDefault="True">_OK</Button>
        <Label Height="50" Margin="12,-12,12,0" Name="NameLabel" VerticalAlignment="Top" FontSize="32" HorizontalContentAlignment="Center" Grid.ColumnSpan="2">
            <Label.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" />
            </Label.Effect>
            Label
        </Label>
        <Label Margin="13,24,11,0" Name="VersionLabel" HorizontalContentAlignment="Center" FontSize="16" Height="28" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <Label.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" />
            </Label.Effect>
            Label
        </Label>
        <Label Margin="13,46,11,0" Name="CompanyLabel" HorizontalContentAlignment="Center" FontSize="16" Grid.ColumnSpan="2" Height="38" VerticalAlignment="Top">
            <Label.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" />
            </Label.Effect>
            Label
        </Label>
        <Button Height="23" Margin="13,0,11,1" Name="Button1" VerticalAlignment="Bottom">_Website</Button>
        <Label FontSize="16" HorizontalContentAlignment="Center" Margin="13,70,11,0" Name="Label1" Grid.ColumnSpan="2" Height="42" VerticalAlignment="Top">
            <Label.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" />
            </Label.Effect>
            Label
        </Label>
    </Grid>
</Window>
